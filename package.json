{
  "name": "@dispositio/platform-client",
  "version": "1.0.1",
  "description": "Anbindung der Dispositio-Werkzeuge an die Plattform: Vertrag der internen Schnittstelle, Fastify-Plugin, React-Teile und Tokens.",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/platform.css": "./styles/platform.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "fastify": "^5.12.8",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
